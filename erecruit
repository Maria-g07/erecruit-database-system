ΙΙΙ) Δημιουργήσαμε τον παρακάτω πίνακα

CREATE TABLE history (
id int(11) NOT NULL AUTO_INCREMENT,
username VARCHAR(12) NOT NULL,
hmeromhnia DATETIME DEFAULT CURRENT_TIMESTAMP,
success tinyint,
table_name VARCHAR(30),
action ENUM('insert', 'update', 'delete'),
PRIMARY KEY (id),
CONSTRAINT HISTORY_USERNAME FOREIGN KEY (username) REFERENCES user(username) ON DELETE CASCADE ON UPDATE CASCADE
)engine=InnoDB;


