Ι) Δημιουργήσαμε τον παρακάτω πίνακα


CREATE TABLE interviews (
id int(11) NOT NULL AUTO_INCREMENT,
recruiter_username VARCHAR(12) NOT NULL,
cand_username VARCHAR(12) NOT NULL,
hmeromhnia DATETIME,
duration int(11),
comments TEXT,
personality TINYINT,
education TINYINT,
experience TINYINT,
PRIMARY KEY (id),
CONSTRAINT INTERVIEWS_RECR FOREIGN KEY (recruiter_username) REFERENCES recruiter(username) ON DELETE CASCADE ON UPDATE CASCADE,
CONSTRAINT INTERVIEWS_CAND FOREIGN KEY (cand_username) REFERENCES candidate(username) ON DELETE CASCADE ON UPDATE CASCADE
)engine=InnoDB;



